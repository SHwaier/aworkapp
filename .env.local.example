# AWorkApp Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb://localhost:27017/AWorkApp

# ============================================
# AUTHENTICATION
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-change-me-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-me-in-production

# AI Models (Gemini)
GEMINI_API_KEY=your-gemini-api-key-change-me-in-production

# Token expiry
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Follow these steps to obtain credentials:
# 1. Go to the Google Cloud Console (https://console.cloud.google.com)
# 2. Create a new project or select an existing one.
# 3. Go to API & Services > Credentials.
# 4. Click "+ CREATE CREDENTIALS" and choose "OAuth client ID".
# 5. Set Application type to "Web application".
# 6. Add Authorized JavaScript origins:
#    - Development: http://localhost:3000
# 7. Add Authorized Redirect URIs:
#    - Development: http://localhost:3000/api/auth/google/callback
#    - Production: https://yourdomain.com/api/auth/google/callback
# 8. Copy the Client ID and Client Secret into the variables below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# FILE STORAGE
# ============================================
# For MVP, files are stored locally. In production, use S3/R2.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./uploads
# MAX_FILE_SIZE in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# S3-compatible storage (for production)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ============================================
# SECURITY
# ============================================
# CSRF secret for double-submit cookie pattern
CSRF_SECRET=your-csrf-secret-change-me-in-production

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ============================================
# APPLICATION
# ============================================
NEXT_PUBLIC_APP_NAME=AWorkApp
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

